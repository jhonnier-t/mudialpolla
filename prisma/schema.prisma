// Polla Mundialista — esquema de datos
// SQLite no soporta enums nativos en Prisma, por eso los campos de
// rol/fase/estado son String con valores controlados desde src/lib/constants.ts

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  name         String
  passwordHash String
  role         String       @default("PLAYER") // ADMIN | PLAYER
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  predictions  Prediction[]
}

model Team {
  id        String  @id @default(cuid())
  name      String  @unique
  code      String  @unique // código FIFA de 3 letras, ej: COL
  flag      String  @default("") // emoji de bandera
  groupName String? // grupo del mundial: A..L
  matchesA  Match[] @relation("TeamA")
  matchesB  Match[] @relation("TeamB")
}

model Match {
  id          String       @id @default(cuid())
  phase       String       @default("GROUP") // GROUP | R32 | R16 | QF | SF | THIRD | FINAL
  groupName   String? // solo fase de grupos
  teamAId     String
  teamBId     String
  teamA       Team         @relation("TeamA", fields: [teamAId], references: [id])
  teamB       Team         @relation("TeamB", fields: [teamBId], references: [id])
  kickoff     DateTime
  stadium     String       @default("")
  scoreA      Int?
  scoreB      Int?
  status      String       @default("SCHEDULED") // SCHEDULED | FINISHED
  predictions Prediction[]

  @@index([kickoff])
}

model Prediction {
  id        String   @id @default(cuid())
  userId    String
  matchId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  predA     Int
  predB     Int
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([userId, matchId])
}
